{
  "name": "learnmath",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node build.mjs",
    "serve": "npx --yes http-server dist -p 8089 -c-1",
    "deploy": "npm run build && sh scripts/deploy.sh",
    "pdf": "mkdir -p pdf && for g in 4 5 6 7 10 11 12; do node tools/pdf.mjs ../math$g && cp ../math$g/math$g.pdf pdf/; done && cp ../math8-9/math8-9.pdf pdf/"
  },
  "dependencies": {
    "@mdit/plugin-tex": "^1.3.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3"
  }
}
